@model Viajecitos_WebCliente.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<!-- Estilos modernos y responsivos -->
<style>
    body {
        min-height: 100vh;
        margin: 0;
        background: linear-gradient(rgba(43,85,220,0.45), rgba(0,0,0,0.15)),
                    url('/imagenes/login.jpg') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', 'Roboto', Arial, sans-serif;
    }
    .login-overlay {
        background: rgba(255,255,255,0.95);
        border-radius: 1.8rem;
        box-shadow: 0 10px 40px 0 rgba(31, 38, 135, 0.22);
        backdrop-filter: blur(4px);
        border: 1px solid #e3e3e3;
        padding: 0;
    }
    .card-header.bg-gradient-primary {
        background: linear-gradient(90deg, #0ea5e9 0%, #6366f1 100%) !important;
        border-radius: 1.8rem 1.8rem 0 0 !important;
    }
    .btn-primary {
        background: linear-gradient(90deg, #3b82f6 0%, #6366f1 100%);
        border: none;
        transition: background 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 24px rgba(99, 102, 241, 0.12);
    }
    .btn-primary:hover, .btn-primary:focus {
        background: linear-gradient(90deg, #6366f1 0%, #3b82f6 100%);
        box-shadow: 0 8px 32px rgba(99, 102, 241, 0.22);
    }
    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 0.15rem rgba(99,102,241,.15);
    }
    .input-group-text {
        background: #f8fafc !important;
    }
    .card-body {
        border-radius: 0 0 1.8rem 1.8rem;
    }
    @@media (max-width: 768px) {
        .login-overlay {
            border-radius: 1.2rem;
            margin: 0 1.5rem;
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
        .card-header.bg-gradient-primary {
            border-radius: 1.2rem 1.2rem 0 0 !important;
        }
        .card-body {
            border-radius: 0 0 1.2rem 1.2rem;
        }
    }
</style>

<div class="container vh-100 d-flex flex-column justify-content-center align-items-center">
    <div class="row w-100">
        <div class="col-lg-5 col-md-7 col-sm-10 mx-auto">
            <div class="card shadow-lg border-0 login-overlay">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h3 class="fw-bold mb-0">
                        <i class="bi bi-person-circle me-2"></i>
                        Bienvenido a Viajecitos SA
                    </h3>
                    <span class="fw-normal fs-6">Inicia sesión para continuar</span>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center mb-4">@ViewBag.Error</div>
                    }
                    <form asp-action="Login" method="post" autocomplete="off">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Correo electrónico</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-pill" placeholder="correo@ejemplo.com" autocomplete="off" required />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Contraseña" class="form-label fw-semibold">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="Contraseña" type="password" class="form-control form-control-lg rounded-pill" placeholder="••••••••" required id="passwordInput" autocomplete="off" />
                                <span class="input-group-text bg-white rounded-end border-0" style="cursor:pointer" onclick="togglePassword()">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow">
                            <i class="bi bi-box-arrow-in-right"></i> Ingresar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword() {
            var pwd = document.getElementById("passwordInput");
            var icon = document.getElementById("eyeIcon");
            if (pwd.type === "password") {
                pwd.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                pwd.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
