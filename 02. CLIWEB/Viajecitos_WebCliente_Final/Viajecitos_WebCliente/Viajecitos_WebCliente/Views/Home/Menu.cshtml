@{
    var nombre = Context.Session.GetString("Nombre") ?? "Usuario";
    var apellido = Context.Session.GetString("Apellido") ?? "";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0" style="border-radius: 15px;">
                <div class="card-header bg-gradient-primary text-white text-center py-4 rounded-top">
                    <h2 class="fw-bold mb-1"><i class="bi bi-airplane me-2"></i> Menú Principal</h2>
                    <div class="fs-5"><i class="bi bi-person-circle me-2"></i>@nombre @apellido</div>
                </div>
                <div class="card-body bg-light p-5">
                    <div class="row g-4 justify-content-center">
                        <!-- Botón Buscar Vuelos -->
                        <div class="col-md-5">
                            <a asp-controller="Vuelos" asp-action="Buscar" class="btn btn-primary btn-lg w-100 py-4 rounded-pill shadow d-flex flex-column align-items-center"
                               style="background-color: #0a96b0; border-color: #0a96b0; transition: all 0.3s;">
                                <i class="bi bi-search fs-1 mb-2"></i>
                                Buscar y comprar vuelos
                            </a>
                        </div>

                        <!-- Botón Consultar Facturas -->
                        <div class="col-md-5">
                            <a asp-controller="Facturas" asp-action="Consultar" class="btn btn-success btn-lg w-100 py-4 rounded-pill shadow d-flex flex-column align-items-center"
                               style="background-color: #3db39e; border-color: #3db39e; transition: all 0.3s;">
                                <i class="bi bi-receipt fs-1 mb-2"></i>
                                Consultar facturas
                            </a>
                        </div>

                        <!-- Botón Historial -->
                        <div class="col-md-5">
                            <a asp-controller="Facturas" asp-action="Historial" class="btn btn-warning btn-lg w-100 py-4 rounded-pill shadow d-flex flex-column align-items-center mt-4"
                               style="background-color: #f6a800; border-color: #f6a800; transition: all 0.3s;">
                                <i class="bi bi-clock-history fs-1 mb-2"></i>
                                Historial de compras
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-center bg-white py-3">
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-lg rounded-pill px-4">
                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        overflow: hidden;
        border: none;
    }

    .btn-primary:hover {
        background-color: #09819a !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(10, 150, 176, 0.3) !important;
    }

    .btn-success:hover {
        background-color: #36a18e !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(61, 179, 158, 0.3) !important;
    }

    .btn-warning:hover {
        background-color: #e09900 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(246, 168, 0, 0.3) !important;
    }

    .rounded-pill {
        border-radius: 50rem !important;
    }

    body {
        min-height: 100vh;
        /* Cambia la ruta a la imagen que tengas en wwwroot/img */
        background: url('/imagenes/vuelo.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    .login-overlay {
        background: rgba(255,255,255,0.88);
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.18);
        backdrop-filter: blur(3px);
    }
    /* Opcional: mejora en dispositivos pequeños */
    @@media (max-width: 768px) {
        .login-overlay {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
    }
</style>